# Cargos ligados (padrao: presidente,governador,senador,deputado-federal,deputado-estadual).
# Para desligar deputados: CARGOS=presidente,governador,senador (fotos de deputados nunca sao baixadas).
# CARGOS=presidente,governador,senador,deputado-federal,deputado-estadual

# Intervalo entre atualizacoes de cada arquivo do cargo (segundos)
INTERVAL_PRESIDENTE=30
INTERVAL_GOVERNADOR=60
INTERVAL_SENADOR=60
# Usado por deputado-federal e deputado-estadual (prioridade abaixo de presidente/governador/senador)
INTERVAL_DEPUTADOS=300

# Pausa entre requisicoes (ms) e timeout de cada requisicao (s)
REQUEST_PAUSE_MS=200
# REQUEST_TIMEOUT=10

# Arquivo inexistente (404): nova tentativa em N segundos (dados / foto)
# NOTFOUND_RETRY=120
# FOTO_404_RETRY=3600
# Descoberta do ciclo no ele-c.json: a cada N s enquanto aguardando / depois de ok
# DISCOVERY_WAIT=60
# DISCOVERY_INTERVAL=300

# Simulado (padrao)
TSE_BASE_URL=https://resultados-sim.tse.jus.br
TSE_AMBIENTE=simulado/simulado2026

# Producao (VALIDE no DevTools do painel do TSE antes de usar):
# TSE_BASE_URL=https://resultados.tse.jus.br
# TSE_AMBIENTE=oficial

# Diretorio de saida (no container e /data)
# DATA_DIR=/data
