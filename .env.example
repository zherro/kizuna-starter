# EXEMPLO — copie para .env e preencha. Variáveis que o @kizuna/core lê.

# --- Obrigatórias ---
# Segredo HS256 do JWT de sessão. TEM que bater com o secret que o PostgREST verifica.
# Aceita qualquer um dos dois nomes.
PGRST_JWT_SECRET=this_is_a_super_secret_key_1234567890
# JWT_SECRET=

# Base das chamadas pgrstTable / pgrstRpc (ex.: http://localhost:3001).
POSTGREST_URL=http://127.0.0.1:3004

# Token do papel service_role (sql/0117) — excluir conta, ticket de conta recriada, revogação de
# sessão. Gere com: node kizuna-core/cli token service. SÓ servidor (nunca NEXT_PUBLIC_*).
# Vazio: exclusão de conta responde 503 e a revogação de sessão fica desligada.
POSTGREST_SERVICE_TOKEN=

# --- Opcionais ---
# Email (kizuna-core/docs/EMAIL.md)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Otimização de imagem no upload (aceita TINYPNG_API_KEY ou TINIFY_API_KEY)
TINYPNG_API_KEY=

# Features de AI (Google Gemini)
GEMINI_API_KEY=

# Liga a rota /showcase (1 para habilitar)
SHOWCASE_ENABLED=1

# Estilo de forma da UI: classic (padrão) | soft. Entra no build. Ver kizuna-core/docs/interface/componentes.md
# NEXT_PUBLIC_UI_STYLE=classic

# Loga um curl equivalente por chamada ao PostgREST (1 para habilitar)
DEBUG_HTTP=

# A cara do header (variant) e da home (hero, layout de categorias, banner "Descobrir no swipe")
# não é mais por env — está em kizuna.config.json (chave "home").
# Recuperar senha — link enviado por e-mail (precisa do SMTP acima). Ver docs/comecando/recuperar-senha.md
# URL pública do app, usada no link do e-mail (sem barra no final)
APP_URL=
# Nome exibido no e-mail
APP_NAME=
# Validade do link em minutos (5–1440, default 60)
PASSWORD_RESET_TTL_MINUTES=

# Captcha (Cloudflare Turnstile) no login/cadastro — liga quando as DUAS chaves existem.
# NEXT_PUBLIC_* entra no build: trocar exige rebuild. Ver kizuna-core/docs/comecando/captcha.md
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# "false" desliga mesmo com as chaves
AUTH_CAPTCHA_ENABLED=

# Login com Google (OAuth). Sem as duas, o botão "Continuar com Google" não aparece.
# Redirect URI a cadastrar no Google Cloud: <APP_URL>/api/auth/oauth/google/callback
# Ver kizuna-core/docs/comecando/login-social-telefone.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Eleição 2026 (/eleicao) ---
# Diretório com os JSONs gerados pelo cron (meta.json, nacional.json, uf/XX.json).
# Default: ./eleicao-cron/data (em dev, sem esse diretório, usa tests/fixtures/eleicao).
# ELEICAO_DATA_PATH=./eleicao-cron/data
# Segredo do cookie de liberação do rate limit. Opcional: sem ele usa PGRST_JWT_SECRET/JWT_SECRET.
# ELEICAO_COOKIE_SECRET=

# Versão exibida no rodapé (conferir se o deploy subiu). Opcionais — sem elas vale o "version"
# do package.json / kizuna-core/package.json, incrementado a cada push pelo scripts/publish.sh.
APP_VERSION=
KIZUNA_CORE_VERSION=
